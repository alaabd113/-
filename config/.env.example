# Copy to ../.env, fill your cTrader DEMO OAuth values. NEVER COMMIT .env.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_SYMBOL_ID=
# Explicit authorization for DEMO orders only (NO LIVE endpoint in code)
CTRADER_DEMO_CONFIRMED=YES
CTRADER_ALLOW_DEMO_ORDER=YES

# OPTIONAL: dedicated Telegram owner control (do not reuse bot with active webhook)
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_OWNER_ID=
# Set YES only for a dedicated bot without existing webhook
GOLD_TELEGRAM_POLL=NO
